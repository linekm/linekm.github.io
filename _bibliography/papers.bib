@article{VLDB27:obligraph,
  abbr         = {VLDB'27},
  bibtex_show  = {true},
  title        = {ObliGraph: Graph Pattern Query Processing with Full and Differential Obliviousness},
  author       = {Xu, Lyu and Zhang, Xinyi and Wang, Qichen},
  journal      = {Proceedings of the VLDB Endowment (PVLDB)},
  volume       = {20},
  number       = {3},
  pages        = {510--523},
  year         = {2026},
  doi          = {10.14778/3860016.3860020},
  arxiv        = {2611.25405},
  pdf          = {https://arxiv.org/pdf/2611.25405},
  abstract     = {Graph pattern query is a fundamental primitive in graph databases for retrieving data graphs that match a query graph under various structural constraints. As graph data is increasingly outsourced to third-party cloud servers for scalable query processing, however, both the query graph and the data graphs may leak sensitive structural information through server-side access patterns. In this paper, we study privacy-preserving graph pattern query processing in the outsourced setting, aiming to protect the structures of both the query and data graphs from access-pattern leakage. To this end, we propose ObliGraph, the first oblivious graph search framework that supports multiple classes of graph pattern queries under two privacy modes: FOS achieves full obliviousness by uniformly evaluating candidate mappings, making the server-side access pattern independent of the structures of the query and data graphs; DOS further improves query efficiency through pruning while retaining a provable privacy guarantee of differential obliviousness. This design enables a smooth trade-off between stronger privacy and higher efficiency within a single framework. Experiments on real and synthetic datasets demonstrate that ObliGraph efficiently supports a range of graph pattern queries, achieving substantial improvements while preserving strong privacy guarantees.},
  selected     = {true}
}

@article{arXiv26:vida,
  abbr         = {arXiv},
  bibtex_show  = {true},
  title        = {Authenticated Approximate Nearest Neighbor Search in Outsourced Vector Databases},
  author       = {Zhou, Yuanhang and Zhang*, Xinyi and Xu, Cheng and Xu, Jianliang},
  journal      = {arXiv preprint arXiv:2611.16516},
  year         = {2026},
  arxiv        = {2611.16516},
  pdf          = {https://arxiv.org/pdf/2611.16516},
  annotation   = {* Corresponding author},
  abstract     = {Approximate Nearest Neighbor (ANN) search has become a fundamental query primitive in modern vector databases for managing large-scale embedding data. To support growing vector collections, organizations increasingly outsource database management and query processing to third-party clouds. However, untrusted service providers may return suboptimal or fabricated results, posing a serious threat to ANN search integrity. Existing authenticated ANN approaches face substantial scalability challenges. They typically require transmitting high-dimensional vectors for distance verification and rely on topology-agnostic authentication structures, resulting in excessive communication and verification overhead. In this paper, we propose VIDA, a novel and efficient scheme for authenticated graph-based ANN search. VIDA replaces raw vector transmission with compact vector commitments and employs an aggregated Inner Product Argument to efficiently verify multiple distance computations. Furthermore, we introduce MeST, a topology-aware authenticated data structure that aligns authentication paths with graph traversal, significantly reducing structural proof overhead. Additionally, we design a quantization-aware authentication strategy that exploits distance bounds for pruning, reducing the number of exact distances requiring cryptographic authentication. Extensive experiments demonstrate that the proposed schemes substantially improve the efficiency of authenticated ANN search, achieving up to a 6.6x speedup in end-to-end latency and reducing data transfer time by up to 99.2\% compared with state-of-the-art methods.},
  selected     = {true}
}

@article{SIGMOD26:hire,
  abbr         = {SIGMOD'26},
  bibtex_show  = {true},
  title        = {HIRE: A Hybrid Learned Index for Robust and Efficient Performance under Mixed Workloads},
  author       = {Zhang, Xinyi and Liang, Liang and Ailamaki, Anastasia and Xu, Jianliang},
  journal      = {Proceedings of the ACM on Management of Data (SIGMOD)},
  volume       = {4},
  number       = {1},
  articleno    = {43},
  numpages     = {25},
  month        = feb,
  year         = {2026},
  doi          = {10.1145/3786657},
  html         = {https://doi.org/10.1145/3786657},
  pdf          = {https://arxiv.org/pdf/2511.21307},
  slides       = {hire_slides.pptx},
  abstract     = {Indexes are critical for efficient data retrieval and updates in modern databases. Recent advances in machine learning have led to the development of learned indexes, which model the cumulative distribution function of data to predict search positions and accelerate query processing. While learned indexes substantially outperform traditional structures for point lookups, they often suffer from high tail latency, suboptimal range query performance, and inconsistent effectiveness across diverse workloads. To address these challenges, this paper proposes HIRE, a hybrid in-memory index structure designed to deliver efficient performance consistently. HIRE combines the structural and performance robustness of traditional indexes with the predictive power of model-based prediction to reduce search overhead while maintaining worst-case stability. Experimental results on multiple real-world datasets demonstrate that HIRE outperforms both state-of-the-art learned indexes and traditional structures in range-query throughput, tail latency, and overall stability, achieving up to 41.7x higher throughput under mixed workloads and reducing tail latency by up to 98%.},
  selected     = {true}
}

@inproceedings{DAC25:edge,
  abbr         = {DAC'25},
  bibtex_show  = {true},
  title        = {EDGE: DBMS-Empowered Boolean Decomposition for GIG Synthesis},
  author       = {Tang, Ruofei and Zhu, Xuliang and Zhang, Xinyi and Chen, Lei and Li, Xing and Yuan, Mingxuan and Xu, Jianliang},
  booktitle    = {Proceedings of the 62nd Annual ACM/IEEE Design Automation Conference (DAC)},
  series       = {DAC '25},
  articleno    = {408},
  numpages     = {7},
  location     = {San Francisco, California, United States},
  publisher    = {IEEE Press},
  isbn         = {9798331503048},
  year         = {2025},
  doi          = {10.1109/DAC63849.2025.11133306},
  html         = {https://doi.org/10.1109/DAC63849.2025.11133306},
  abstract     = {Boolean decomposition is a powerful technique in logic synthesis that breaks down Boolean functions into simpler components. Decomposition-based logic synthesis yields high-quality results and is particularly effective when combined with small-window optimization methods in Gate-Inverter Graphs (GIG). However, the efficiency limitations of current methods have constrained their applicability in handling large and complex logic. To address this challenge, we propose a novel framework, called EDGE, which leverages modern database techniques to accelerate Boolean decomposition, thereby achieving improved synthesis results while maintaining high efficiency. Experimental results demonstrate a runtime speedup of up to 21x and an overall reduction in node count of at least 15\% compared to state-of-the-art synthesis methods.}
}

@article{SIGMOD24:fedknn,
  abbr         = {SIGMOD'24},
  bibtex_show  = {true},
  title        = {FedKNN: Secure Federated k-Nearest Neighbor Search},
  author       = {Zhang, Xinyi and Wang, Qichen and Xu, Cheng and Peng, Yun and Xu, Jianliang},
  journal      = {Proceedings of the ACM on Management of Data (SIGMOD)},
  volume       = {2},
  number       = {1},
  articleno    = {11},
  numpages     = {26},
  month        = mar,
  year         = {2024},
  doi          = {10.1145/3639266},
  html         = {https://doi.org/10.1145/3639266},
  pdf          = {https://www.comp.hkbu.edu.hk/%7Edb/fedknn_cr_tech_report.pdf},
  slides       = {fedknn_slides.pptx},
  abstract     = {Nearest neighbor search is a fundamental task in various domains, such as federated learning, data mining, information retrieval, and biomedicine. With the increasing need to utilize data from different organizations while respecting privacy regulations, private data federation has emerged as a promising solution. However, it is costly to directly apply existing approaches to federated k-nearest neighbor (kNN) search with difficult-to-compute distance functions, like graph or sequence similarity. To address this challenge, we propose FedKNN, a system that supports secure federated kNN search queries with a wide range of similarity measurements. Our system is equipped with a new Distribution-Aware kNN (DANN) algorithm to minimize unnecessary local computations while protecting data privacy. We further develop DANN*, a secure version of DANN that satisfies differential obliviousness. Extensive evaluations show that FedKNN outperforms state-of-the-art solutions, achieving up to 4.8x improvement on federated graph kNN search and up to 2.7x improvement on federated sequence kNN search.},
  selected     = {true}
}
